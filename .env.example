# Copy this file to .env and replace the authentication placeholders.
# Public sample credentials for the bundled local development database.
# Replace this literal URL when connecting to a different database.
DATABASE_URL=postgresql://scheduling:scheduling_local_dev@localhost:5433/scheduling_dev

# Auth.js: generate AUTH_SECRET with `openssl rand -base64 32`.
AUTH_SECRET=replace-with-a-random-secret
AUTH_URL=http://localhost:3000

# Register http://localhost:3000/api/auth/callback/github for the local OAuth app.
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret

# Add ?sslmode=require when required by your hosted PostgreSQL provider.
