# Copy this file to .env and fill in your actual values.

# Auth.js Configuration
# See https://authjs.dev/guides/environment-variables
AUTH_SECRET="your_strong_random_secret_here" # IMPORTANT: Generate a strong secret for production.
                                             # You can use: `openssl rand -base64 32`
                                             # Or visit a site like https://generate-secret.vercel.app/32

# Application Environment
NODE_ENV="development" # e.g., "development", "test", or "production"

# Full Database Connection URL - Simple string format
# In production or when using a serverless database, add ?sslmode=require at the end
POSTGRES_URL=postgresql://your_postgres_user:your_postgres_password@postgres:5432/your_postgres_db_name

# Example for production/serverless:
# POSTGRES_URL=postgresql://your_postgres_user:your_postgres_password@postgres:5432/your_postgres_db_name?sslmode=require
# Example for local development:
# POSTGRES_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5432/your_postgres_db_name

# GitHub OAuth Credentials
# Enable GitHub authentication, register an OAuth app on GitHub
# (https://github.com/settings/developers) and add the Client ID and Client Secret here.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""